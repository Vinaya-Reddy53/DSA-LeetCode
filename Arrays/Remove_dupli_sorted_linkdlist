/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     struct ListNode *next;
 * };
 */
struct ListNode* deleteDuplicates(struct ListNode* head)
{
    struct ListNode *temp=NULL;
    struct ListNode *prev=head;
    if(head==NULL)
    return head;
    temp=prev->next;
    while(temp!=NULL)
    {
        if(prev->val==temp->val)
        {
            prev->next=temp->next;
            free(temp);
            temp=prev->next;
        }
        else
        {
            prev=temp;
            temp=temp->next;
        }
    }
    return head;
}
        
